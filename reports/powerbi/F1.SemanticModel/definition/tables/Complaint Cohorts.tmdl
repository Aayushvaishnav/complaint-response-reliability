	/// Focused Monthly Issue Share; dynamic selected population; undefined is BLANK.
	measure 'Focused Monthly Issue Share' =
			VAR _single = HASONEVALUE('Review Selection'[Selection Key])
			VAR _company = SELECTEDVALUE('Review Selection'[Company Key])
			VAR _product = SELECTEDVALUE('Review Selection'[Product Key])
			VAR _issue = SELECTEDVALUE('Review Selection'[Issue Key])
			VAR _end = SELECTEDVALUE('Review Selection'[Window End])
			VAR _selectedDates = CALCULATETABLE(VALUES('Date'[Date]), ALLSELECTED('Date'))
			VAR _month = SELECTEDVALUE('Date'[Month Start])
			VAR _monthDates = FILTER(_selectedDates, 'Date'[Date] >= _month && 'Date'[Date] < EDATE(_month, 1))
			VAR _visible = _single && NOT ISBLANK(_month) && _month >= EDATE(_end, -2) && _month <= _end
			VAR _focal = CALCULATE([Complaint Count], REMOVEFILTERS('Review Selection'), REMOVEFILTERS('Date'), TREATAS(_monthDates, 'Date'[Date]), KEEPFILTERS(TREATAS({_company}, 'Company'[Company Key])), KEEPFILTERS(TREATAS({_product}, 'Product'[Product Key])), KEEPFILTERS(TREATAS({_issue}, 'Issue'[Issue Key])))
			VAR _peer = CALCULATE([Complaint Count], REMOVEFILTERS('Review Selection'), REMOVEFILTERS('Date'), TREATAS(_monthDates, 'Date'[Date]), KEEPFILTERS(TREATAS({_company}, 'Company'[Company Key])), KEEPFILTERS(TREATAS({_product}, 'Product'[Product Key])), REMOVEFILTERS('Issue'), 'Issue'[Issue Key] <> _issue)
			RETURN IF(_visible, DIVIDE(_focal, _focal + _peer), BLANK())
		formatString: 0.00%
		displayFolder: Focused Evidence
		lineageTag: 7ed9dc7c-860b-43f5-bf44-42749aeabbdd

	/// Issue Share Change pp; dynamic selected population; undefined is BLANK.
	measure 'Issue Share Change pp' =
			VAR _single = HASONEVALUE('Review Selection'[Selection Key])
			VAR _company = SELECTEDVALUE('Review Selection'[Company Key])
			VAR _product = SELECTEDVALUE('Review Selection'[Product Key])
			VAR _issue = SELECTEDVALUE('Review Selection'[Issue Key])
			VAR _end = SELECTEDVALUE('Review Selection'[Window End])
			VAR _selectedDates = CALCULATETABLE(VALUES('Date'[Date]), ALLSELECTED('Date'))
			VAR _month = SELECTEDVALUE('Date'[Month Start])
			VAR _monthDates = FILTER(_selectedDates, 'Date'[Date] >= _month && 'Date'[Date] < EDATE(_month, 1))
			VAR _visible = _single && NOT ISBLANK(_month) && _month >= EDATE(_end, -2) && _month <= _end
			VAR _prior = EDATE(_month, -1)
			VAR _priorDates = FILTER(_selectedDates, 'Date'[Date] >= _prior && 'Date'[Date] < _month)
			VAR _sameEra = _month < DATE(2023,8,1) || _prior >= DATE(2023,9,1)
			VAR _currentFocal = CALCULATE([Complaint Count], REMOVEFILTERS('Review Selection'), REMOVEFILTERS('Date'), TREATAS(_monthDates, 'Date'[Date]), KEEPFILTERS(TREATAS({_company}, 'Company'[Company Key])), KEEPFILTERS(TREATAS({_product}, 'Product'[Product Key])), KEEPFILTERS(TREATAS({_issue}, 'Issue'[Issue Key])))
			VAR _currentPeer = CALCULATE([Complaint Count], REMOVEFILTERS('Review Selection'), REMOVEFILTERS('Date'), TREATAS(_monthDates, 'Date'[Date]), KEEPFILTERS(TREATAS({_company}, 'Company'[Company Key])), KEEPFILTERS(TREATAS({_product}, 'Product'[Product Key])), REMOVEFILTERS('Issue'), 'Issue'[Issue Key] <> _issue)
			VAR _priorFocal = CALCULATE([Complaint Count], REMOVEFILTERS('Date'), TREATAS(_priorDates, 'Date'[Date]),
			    KEEPFILTERS(TREATAS({_company}, 'Company'[Company Key])), KEEPFILTERS(TREATAS({_product}, 'Product'[Product Key])),
			    KEEPFILTERS(TREATAS({_issue}, 'Issue'[Issue Key])))
			VAR _priorTotal = CALCULATE([Complaint Count], REMOVEFILTERS('Date'), TREATAS(_priorDates, 'Date'[Date]),
			    KEEPFILTERS(TREATAS({_company}, 'Company'[Company Key])), KEEPFILTERS(TREATAS({_product}, 'Product'[Product Key])), REMOVEFILTERS('Issue'))
			RETURN IF(_visible && _sameEra && COUNTROWS(_monthDates) = DAY(EOMONTH(_month,0)) &&
			    COUNTROWS(_priorDates) = DAY(EOMONTH(_prior,0)) && _currentFocal + _currentPeer > 0 && _priorTotal > 0,
			    100 * (DIVIDE(_currentFocal, _currentFocal + _currentPeer) - DIVIDE(_priorFocal, _priorTotal)), BLANK())
		formatString: 0.00
		displayFolder: Focused Evidence
		lineageTag: 83959a38-08b6-4372-bc94-38ebb52cc206

	/// Qualifying queue display of Elevated Months; BLANK outside qualifying windows. Use the original diagnostic measure for rejected-window audits.
	measure 'Queue Elevated Months' =
			VAR _selectedDates = CALCULATETABLE(VALUES('Date'[Date]), ALLSELECTED('Date'))
			VAR _monthCounts = CALCULATETABLE(
			    SUMMARIZECOLUMNS('Date'[Month Start], "__selectedDays", COUNTROWS('Date')),
			    REMOVEFILTERS('Date'), TREATAS(_selectedDates, 'Date'[Date]))
			VAR _completeMonths = SELECTCOLUMNS(FILTER(_monthCounts,
			    'Date'[Month Start] <> DATE(2023,8,1) &&
			    [__selectedDays] = DAY(EOMONTH('Date'[Month Start], 0))),
			    "__completeMonth", 'Date'[Month Start])
			VAR _ends = VALUES('Review Window'[Window End])
			VAR _minimum = IF(NOT ISFILTERED('Review Minimum'), 100,
			    IF(HASONEVALUE('Review Minimum'[Minimum]), SELECTEDVALUE('Review Minimum'[Minimum]), BLANK()))
			VAR _companies = VALUES('Company'[Company Key])
			VAR _products = VALUES('Product'[Product Key])
			VAR _issues = VALUES('Issue'[Issue Key])
			VAR _identities = SELECTCOLUMNS(ALL('Review Selection'),
			    "__key", 'Review Selection'[Selection Key], "__segment", 'Review Selection'[Segment Key],
			    "__company", 'Review Selection'[Company Key] + 0,
			    "__product", 'Review Selection'[Product Key] + 0,
			    "__issue", 'Review Selection'[Issue Key] + 0,
			    "__end", EDATE('Review Selection'[Window End], 0))
			VAR _candidates = FILTER(_identities, [__end] IN _ends && [__company] IN _companies &&
			    [__product] IN _products && [__issue] IN _issues)
			VAR _grouped = CALCULATETABLE(
			    SUMMARIZECOLUMNS('Company'[Company Key], 'Product'[Product Key],
			        'Issue'[Issue Key], 'Date'[Month Start],
			        "__fc", SUM('Complaint Cohorts'[Complaint Rows]),
			        "__fk", SUM('Complaint Cohorts'[Yes Rows]) + SUM('Complaint Cohorts'[No Rows]),
			        "__fn", SUM('Complaint Cohorts'[No Rows]),
			        "__tc", IGNORE(CALCULATE(SUM('Complaint Cohorts'[Complaint Rows]), REMOVEFILTERS('Issue'))),
			        "__tk", IGNORE(CALCULATE(SUM('Complaint Cohorts'[Yes Rows]) + SUM('Complaint Cohorts'[No Rows]), REMOVEFILTERS('Issue'))),
			        "__tn", IGNORE(CALCULATE(SUM('Complaint Cohorts'[No Rows]), REMOVEFILTERS('Issue')))),
			    REMOVEFILTERS('Review Selection'), REMOVEFILTERS('Date'),
			    TREATAS(_completeMonths, 'Date'[Month Start]))
			VAR _withPeers = ADDCOLUMNS(_grouped,
