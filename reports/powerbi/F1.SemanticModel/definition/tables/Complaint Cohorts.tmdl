/// Observed received-day/category/routing-lag bins; counts are frequencies, not complaints per row.
table 'Complaint Cohorts'
	lineageTag: eeb231c0-c5af-4ed0-9cf1-5c02b643fa11

	/// Sum imported complaint frequencies in current context; empty is zero.
	measure 'Complaint Count' = COALESCE(SUM('Complaint Cohorts'[Complaint Rows]), 0)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: afa8d120-f07a-484a-856d-ce590aa1e127

	/// Sum imported complaint frequencies in current context; empty is zero.
	measure 'Timely Yes Count' = COALESCE(SUM('Complaint Cohorts'[Yes Rows]), 0)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 134c331c-f81b-44a7-9697-4e937069e137

	/// Sum imported complaint frequencies in current context; empty is zero.
	measure 'Untimely No Count' = COALESCE(SUM('Complaint Cohorts'[No Rows]), 0)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 94b905f7-97e8-482b-86b4-750fd542f9ef

	/// Sum imported complaint frequencies in current context; empty is zero.
	measure 'Unknown Flag Count' = COALESCE(SUM('Complaint Cohorts'[Unknown Rows]), 0)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 8d245264-b178-484f-99e3-f753f9efdb6f

	/// Exact recorded Yes plus No flags; excludes unknown flags.
	measure 'Known Flag Count' = [Timely Yes Count] + [Untimely No Count]
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 3720db2c-5fd6-41f2-a37b-4f010935b9f3

	/// Timely Yes Count divided by Known Flag Count; undefined is BLANK.
	measure 'Timely Response Rate' = DIVIDE([Timely Yes Count], [Known Flag Count])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: 8ed9369a-16da-413d-9e56-f101c7a7a99e

	/// Untimely No Count divided by Known Flag Count; undefined is BLANK.
	measure 'Untimely Share' = DIVIDE([Untimely No Count], [Known Flag Count])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: bf8a9c53-e958-4b8b-87c0-69167ab3c4ba

	/// Unknown Flag Count divided by Complaint Count; undefined is BLANK.
	measure 'Unknown Flag Rate' = DIVIDE([Unknown Flag Count], [Complaint Count])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: 580b1d97-8485-4219-aa3b-6328e1849add

	/// Frequency of nonnegative valid routing lags.
	measure 'Valid Routing Count' = CALCULATE([Complaint Count], KEEPFILTERS('Complaint Cohorts'[Routing Status] = "valid"))
		formatString: #,##0
		displayFolder: Routing
		lineageTag: 65ccb832-e7f2-4060-85a2-76e977759c3c

	/// All complaints minus valid routing frequencies; includes missing and negative lags.
	measure 'Invalid Routing Count' = [Complaint Count] - [Valid Routing Count]
		formatString: #,##0
		displayFolder: Routing
		lineageTag: f0d1b620-7b67-40b0-a487-eb3011fc62d7

	/// Frequency-weighted median of valid lags; averages both middle observations; empty is BLANK.
	measure 'Median Routing Days' =
			VAR _bins =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Complaint Cohorts'[Routing Days]),
			            "__frequency", CALCULATE(SUM('Complaint Cohorts'[Complaint Rows]))),
			        KEEPFILTERS('Complaint Cohorts'[Routing Status] = "valid"),
			        KEEPFILTERS(NOT ISBLANK('Complaint Cohorts'[Routing Days])),
			        KEEPFILTERS('Complaint Cohorts'[Routing Days] >= 0))
			VAR _total = SUMX(_bins, [__frequency])
			VAR _lowerPosition = INT(DIVIDE(_total + 1, 2))
			VAR _upperPosition = INT(DIVIDE(_total + 2, 2))
			VAR _cumulative = ADDCOLUMNS(_bins, "__cumulative",
			    VAR _day = 'Complaint Cohorts'[Routing Days]
			    RETURN SUMX(FILTER(_bins, 'Complaint Cohorts'[Routing Days] <= _day), [__frequency]))
			VAR _lower = MINX(FILTER(_cumulative, [__cumulative] >= _lowerPosition), 'Complaint Cohorts'[Routing Days])
			VAR _upper = MINX(FILTER(_cumulative, [__cumulative] >= _upperPosition), 'Complaint Cohorts'[Routing Days])
			RETURN IF(_total > 0, DIVIDE(_lower + _upper, 2), BLANK())
		formatString: #,##0.0
		displayFolder: Routing
		lineageTag: 43c9d9ef-51cb-4308-a718-b1ad54f065cc

	/// Issue frequency divided by all issues in current month context; all other filters retained; undefined is BLANK.
	measure 'Monthly Issue Share' = DIVIDE([Complaint Count], CALCULATE([Complaint Count], REMOVEFILTERS('Issue')))
		formatString: 0.00%
		displayFolder: Issue Mix
		lineageTag: 14f060a3-18f8-47b5-afd4-c4a63f0e0ba6

	/// Other issues: all-issue total minus current issue selection; company, product, date and geography retained.
	measure 'Peer Complaint Count' = CALCULATE([Complaint Count], REMOVEFILTERS('Issue')) - [Complaint Count]
		formatString: #,##0
		displayFolder: Peers
		lineageTag: 6d1beafc-ea61-4c45-9fae-f02ae95ad401

	/// Other issues: all-issue total minus current issue selection; company, product, date and geography retained.
	measure 'Peer Known Count' = CALCULATE([Known Flag Count], REMOVEFILTERS('Issue')) - [Known Flag Count]
		formatString: #,##0
		displayFolder: Peers
		lineageTag: 5bf1521e-45e2-40d8-8839-dc476ad96615

	/// Other issues: all-issue total minus current issue selection; company, product, date and geography retained.
	measure 'Peer No Count' = CALCULATE([Untimely No Count], REMOVEFILTERS('Issue')) - [Untimely No Count]
		formatString: #,##0
		displayFolder: Peers
		lineageTag: dc55b869-b393-4345-b111-bb05c66f91cc

	/// Other-issue No flags divided by other-issue known flags; undefined is BLANK.
	measure 'Peer Untimely Share' = DIVIDE([Peer No Count], [Peer Known Count])
		formatString: 0.00%
		displayFolder: Peers
		lineageTag: bf7e9214-bfa0-4931-851e-535a54eee171

	/// Selected Review Minimum; dynamic selected population; undefined is BLANK.
	measure 'Selected Review Minimum' = IF(NOT ISFILTERED('Review Minimum'), 100, IF(HASONEVALUE('Review Minimum'[Minimum]), SELECTEDVALUE('Review Minimum'[Minimum]), BLANK()))
		formatString: #,##0
		displayFolder: Review Priorities
		lineageTag: 5ed71d01-31da-4613-b25a-20033432ce15

	/// Eligible Window Count; dynamic selected population; undefined is BLANK.
	measure 'Eligible Window Count' =
			VAR _selectedDates = CALCULATETABLE(VALUES('Date'[Date]), ALLSELECTED('Date'))
			VAR _monthCounts = CALCULATETABLE(
			    SUMMARIZECOLUMNS('Date'[Month Start], "__selectedDays", COUNTROWS('Date')),
			    REMOVEFILTERS('Date'), TREATAS(_selectedDates, 'Date'[Date]))
			VAR _completeMonths = SELECTCOLUMNS(FILTER(_monthCounts,
			    'Date'[Month Start] <> DATE(2023,8,1) &&
			    [__selectedDays] = DAY(EOMONTH('Date'[Month Start], 0))),
			    "__completeMonth", 'Date'[Month Start])
			VAR _ends = VALUES('Review Window'[Window End])
			VAR _minimum = IF(NOT ISFILTERED('Review Minimum'), 100,
			    IF(HASONEVALUE('Review Minimum'[Minimum]), SELECTEDVALUE('Review Minimum'[Minimum]), BLANK()))
			VAR _companies = VALUES('Company'[Company Key])
			VAR _products = VALUES('Product'[Product Key])
			VAR _issues = VALUES('Issue'[Issue Key])
			VAR _identities = SELECTCOLUMNS(ALL('Review Selection'),
			    "__key", 'Review Selection'[Selection Key], "__segment", 'Review Selection'[Segment Key],
			    "__company", 'Review Selection'[Company Key] + 0,
			    "__product", 'Review Selection'[Product Key] + 0,
			    "__issue", 'Review Selection'[Issue Key] + 0,
			    "__end", EDATE('Review Selection'[Window End], 0))
			VAR _candidates = FILTER(_identities, [__end] IN _ends && [__company] IN _companies &&
			    [__product] IN _products && [__issue] IN _issues)
			VAR _grouped = CALCULATETABLE(
			    SUMMARIZECOLUMNS('Company'[Company Key], 'Product'[Product Key],
			        'Issue'[Issue Key], 'Date'[Month Start],
			        "__fc", SUM('Complaint Cohorts'[Complaint Rows]),
			        "__fk", SUM('Complaint Cohorts'[Yes Rows]) + SUM('Complaint Cohorts'[No Rows]),
			        "__fn", SUM('Complaint Cohorts'[No Rows]),
			        "__tc", IGNORE(CALCULATE(SUM('Complaint Cohorts'[Complaint Rows]), REMOVEFILTERS('Issue'))),
			        "__tk", IGNORE(CALCULATE(SUM('Complaint Cohorts'[Yes Rows]) + SUM('Complaint Cohorts'[No Rows]), REMOVEFILTERS('Issue'))),
			        "__tn", IGNORE(CALCULATE(SUM('Complaint Cohorts'[No Rows]), REMOVEFILTERS('Issue')))),
			    REMOVEFILTERS('Review Selection'), REMOVEFILTERS('Date'),
			    TREATAS(_completeMonths, 'Date'[Month Start]))
			VAR _withPeers = ADDCOLUMNS(_grouped,
			    "__pc", [__tc] - [__fc], "__pk", [__tk] - [__fk], "__pn", [__tn] - [__fn])
			VAR _sparse = FILTER(_withPeers,
			    [__fc] >= 50 && [__pc] >= 50 && [__fk] > 0 && [__pk] > 0)
			VAR _monthly = ADDCOLUMNS(_sparse, "__elevated",
			    INT(100 * ([__fn] * [__pk] - [__pn] * [__fk]) >= [__fk] * [__pk]))
			VAR _shift0 = SELECTCOLUMNS(_monthly, "__company", 'Company'[Company Key] + 0,
			    "__product", 'Product'[Product Key] + 0,
			    "__issue", 'Issue'[Issue Key] + 0,
			    "__end", EDATE('Date'[Month Start], 0),
			    "__m0fc", [__fc],
			    "__m0fk", [__fk],
			    "__m0fn", [__fn],
			    "__m0pc", [__pc],
			    "__m0pk", [__pk],
			    "__m0pn", [__pn],
			    "__m0elevated", [__elevated])
			VAR _shift1 = SELECTCOLUMNS(_monthly, "__company", 'Company'[Company Key] + 0,
			    "__product", 'Product'[Product Key] + 0,
			    "__issue", 'Issue'[Issue Key] + 0,
			    "__end", EDATE('Date'[Month Start], 1),
			    "__m1fc", [__fc],
			    "__m1fk", [__fk],
			    "__m1fn", [__fn],
			    "__m1pc", [__pc],
			    "__m1pk", [__pk],
			    "__m1pn", [__pn],
			    "__m1elevated", [__elevated])
			VAR _shift2 = SELECTCOLUMNS(_monthly, "__company", 'Company'[Company Key] + 0,
			    "__product", 'Product'[Product Key] + 0,
			    "__issue", 'Issue'[Issue Key] + 0,
			    "__end", EDATE('Date'[Month Start], 2),
			    "__m2fc", [__fc],
			    "__m2fk", [__fk],
			    "__m2fn", [__fn],
			    "__m2pc", [__pc],
			    "__m2pk", [__pk],
			    "__m2pn", [__pn],
			    "__m2elevated", [__elevated])
			VAR _windows = NATURALINNERJOIN(NATURALINNERJOIN(_shift0, _shift1), _shift2)
			VAR _joined = NATURALINNERJOIN(_candidates, _windows)
			VAR _statistics = ADDCOLUMNS(_joined,
			    "__complete", TRUE(), "__era", TRUE(), "__known", TRUE(),
			    "__volume", MIN(MIN([__m0fc], [__m0pc]), MIN(MIN([__m1fc], [__m1pc]), MIN([__m2fc], [__m2pc]))), "__elevated", [__m0elevated] + [__m1elevated] + [__m2elevated],
			    "__no", [__m0fn] + [__m1fn] + [__m2fn], "__knownCount", [__m0fk] + [__m1fk] + [__m2fk],
			    "__peerNo", [__m0pn] + [__m1pn] + [__m2pn], "__peerKnown", [__m0pk] + [__m1pk] + [__m2pk],
			    "__complaints", [__m0fc] + [__m1fc] + [__m2fc])
			VAR _evaluated = ADDCOLUMNS(_statistics,
			    "__eligible", NOT ISBLANK(_minimum) && [__volume] >= _minimum,
			    "__stable", [__volume] >= 200 && [__elevated] >= 2)
			VAR _qualified = FILTER(_evaluated, [__eligible] && [__elevated] >= 2)
			RETURN IF(NOT ISBLANK(_minimum), COALESCE(COUNTROWS(FILTER(_evaluated, [__eligible])), 0), BLANK())
		formatString: #,##0
		displayFolder: Review Priorities
		lineageTag: 253ae480-e681-467d-832d-a16799a9f7aa

	/// Qualifying Window Count; dynamic selected population; undefined is BLANK.
	measure 'Qualifying Window Count' =
			VAR _selectedDates = CALCULATETABLE(VALUES('Date'[Date]), ALLSELECTED('Date'))
			VAR _monthCounts = CALCULATETABLE(
			    SUMMARIZECOLUMNS('Date'[Month Start], "__selectedDays", COUNTROWS('Date')),
			    REMOVEFILTERS('Date'), TREATAS(_selectedDates, 'Date'[Date]))
			VAR _completeMonths = SELECTCOLUMNS(FILTER(_monthCounts,
			    'Date'[Month Start] <> DATE(2023,8,1) &&
			    [__selectedDays] = DAY(EOMONTH('Date'[Month Start], 0))),
			    "__completeMonth", 'Date'[Month Start])
			VAR _ends = VALUES('Review Window'[Window End])
			VAR _minimum = IF(NOT ISFILTERED('Review Minimum'), 100,
			    IF(HASONEVALUE('Review Minimum'[Minimum]), SELECTEDVALUE('Review Minimum'[Minimum]), BLANK()))
			VAR _companies = VALUES('Company'[Company Key])
			VAR _products = VALUES('Product'[Product Key])
			VAR _issues = VALUES('Issue'[Issue Key])
			VAR _identities = SELECTCOLUMNS(ALL('Review Selection'),
			    "__key", 'Review Selection'[Selection Key], "__segment", 'Review Selection'[Segment Key],
			    "__company", 'Review Selection'[Company Key] + 0,
			    "__product", 'Review Selection'[Product Key] + 0,
			    "__issue", 'Review Selection'[Issue Key] + 0,
			    "__end", EDATE('Review Selection'[Window End], 0))
			VAR _candidates = FILTER(_identities, [__end] IN _ends && [__company] IN _companies &&
			    [__product] IN _products && [__issue] IN _issues)
			VAR _grouped = CALCULATETABLE(
			    SUMMARIZECOLUMNS('Company'[Company Key], 'Product'[Product Key],
			        'Issue'[Issue Key], 'Date'[Month Start],
			        "__fc", SUM('Complaint Cohorts'[Complaint Rows]),
			        "__fk", SUM('Complaint Cohorts'[Yes Rows]) + SUM('Complaint Cohorts'[No Rows]),
			        "__fn", SUM('Complaint Cohorts'[No Rows]),
			        "__tc", IGNORE(CALCULATE(SUM('Complaint Cohorts'[Complaint Rows]), REMOVEFILTERS('Issue'))),
			        "__tk", IGNORE(CALCULATE(SUM('Complaint Cohorts'[Yes Rows]) + SUM('Complaint Cohorts'[No Rows]), REMOVEFILTERS('Issue'))),
			        "__tn", IGNORE(CALCULATE(SUM('Complaint Cohorts'[No Rows]), REMOVEFILTERS('Issue')))),
			    REMOVEFILTERS('Review Selection'), REMOVEFILTERS('Date'),
			    TREATAS(_completeMonths, 'Date'[Month Start]))
			VAR _withPeers = ADDCOLUMNS(_grouped,
			    "__pc", [__tc] - [__fc], "__pk", [__tk] - [__fk], "__pn", [__tn] - [__fn])
			VAR _sparse = FILTER(_withPeers,
			    [__fc] >= 50 && [__pc] >= 50 && [__fk] > 0 && [__pk] > 0)
			VAR _monthly = ADDCOLUMNS(_sparse, "__elevated",
			    INT(100 * ([__fn] * [__pk] - [__pn] * [__fk]) >= [__fk] * [__pk]))
			VAR _shift0 = SELECTCOLUMNS(_monthly, "__company", 'Company'[Company Key] + 0,
			    "__product", 'Product'[Product Key] + 0,
			    "__issue", 'Issue'[Issue Key] + 0,
			    "__end", EDATE('Date'[Month Start], 0),
			    "__m0fc", [__fc],
			    "__m0fk", [__fk],
			    "__m0fn", [__fn],
			    "__m0pc", [__pc],
			    "__m0pk", [__pk],
			    "__m0pn", [__pn],
			    "__m0elevated", [__elevated])
			VAR _shift1 = SELECTCOLUMNS(_monthly, "__company", 'Company'[Company Key] + 0,
			    "__product", 'Product'[Product Key] + 0,
			    "__issue", 'Issue'[Issue Key] + 0,
			    "__end", EDATE('Date'[Month Start], 1),
			    "__m1fc", [__fc],
			    "__m1fk", [__fk],
			    "__m1fn", [__fn],
			    "__m1pc", [__pc],
			    "__m1pk", [__pk],
			    "__m1pn", [__pn],
			    "__m1elevated", [__elevated])
			VAR _shift2 = SELECTCOLUMNS(_monthly, "__company", 'Company'[Company Key] + 0,
			    "__product", 'Product'[Product Key] + 0,
			    "__issue", 'Issue'[Issue Key] + 0,
			    "__end", EDATE('Date'[Month Start], 2),
			    "__m2fc", [__fc],
			    "__m2fk", [__fk],
			    "__m2fn", [__fn],
			    "__m2pc", [__pc],
			    "__m2pk", [__pk],
			    "__m2pn", [__pn],
			    "__m2elevated", [__elevated])
			VAR _windows = NATURALINNERJOIN(NATURALINNERJOIN(_shift0, _shift1), _shift2)
			VAR _joined = NATURALINNERJOIN(_candidates, _windows)
			VAR _statistics = ADDCOLUMNS(_joined,
			    "__complete", TRUE(), "__era", TRUE(), "__known", TRUE(),
			    "__volume", MIN(MIN([__m0fc], [__m0pc]), MIN(MIN([__m1fc], [__m1pc]), MIN([__m2fc], [__m2pc]))), "__elevated", [__m0elevated] + [__m1elevated] + [__m2elevated],
			    "__no", [__m0fn] + [__m1fn] + [__m2fn], "__knownCount", [__m0fk] + [__m1fk] + [__m2fk],
			    "__peerNo", [__m0pn] + [__m1pn] + [__m2pn], "__peerKnown", [__m0pk] + [__m1pk] + [__m2pk],
			    "__complaints", [__m0fc] + [__m1fc] + [__m2fc])
			VAR _evaluated = ADDCOLUMNS(_statistics,
			    "__eligible", NOT ISBLANK(_minimum) && [__volume] >= _minimum,
			    "__stable", [__volume] >= 200 && [__elevated] >= 2)
			VAR _qualified = FILTER(_evaluated, [__eligible] && [__elevated] >= 2)
			RETURN IF(NOT ISBLANK(_minimum), COALESCE(COUNTROWS(_qualified), 0), BLANK())
		formatString: #,##0
		displayFolder: Review Priorities
		lineageTag: 05bfe583-7661-43ca-84cb-d0983af7ebe2

	/// Qualifying Segment Count; dynamic selected population; undefined is BLANK.
	measure 'Qualifying Segment Count' =
			VAR _selectedDates = CALCULATETABLE(VALUES('Date'[Date]), ALLSELECTED('Date'))
			VAR _monthCounts = CALCULATETABLE(
			    SUMMARIZECOLUMNS('Date'[Month Start], "__selectedDays", COUNTROWS('Date')),
